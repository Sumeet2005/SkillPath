# SkillPath — CognoDB Graph Database Configuration
# Create a free graph instance at https://cognodb.com and obtain your Bolt URI & credentials.

# CognoDB / Neo4j Connection Variables (Supported interchangeably)
COGNODB_URI=bolt+s://db-xxxxxx.bravo.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here

NEO4J_URI=bolt+s://db-xxxxxx.bravo.databases.cognodb.com
NEO4J_USER=cognodb
NEO4J_PASSWORD=your_cognodb_password_here

# Server Port
PORT=5000
